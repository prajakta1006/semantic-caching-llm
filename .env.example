
# Offline-safe default: mock or gemini
LLM_PROVIDER=mock

# Set to a Gemini model when LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=mock-llm-v1

# API key environment variable name
LLM_API_KEY_ENV=GEMINI_API_KEY

# Replace only in your local, untracked .env file when using Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Request timeout in seconds
LLM_TIMEOUT_SECONDS=30

# MongoDB Atlas settings (required by run.py)
MONGODB_URI=your_mongodb_atlas_uri_here
MONGODB_DATABASE=semantic_cache_db
MONGODB_COLLECTION=cache_entries
